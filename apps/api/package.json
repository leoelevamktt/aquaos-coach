{
    "name": "@natacao/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=../../.env src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "pretest": "npm run build -w @natacao/domain",
        "test": "vitest run"
    },
    "dependencies": {
        "@fastify/cors": "^10.0.1",
        "@fastify/multipart": "^10.1.1",
        "@fastify/static": "^10.1.3",
        "@garmin/fitsdk": "^21.214.0",
        "@natacao/domain": "0.1.0",
        "exceljs": "^4.4.0",
        "fastify": "^5.2.1",
        "ffmpeg-static": "^5.3.0",
        "ffprobe-static": "^3.1.0",
        "mammoth": "^1.10.0",
        "pdf-parse": "^2.4.5",
        "pdfkit": "^0.17.2",
        "pg": "^8.13.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/node": "^22.10.5",
        "@types/pdfkit": "^0.17.3",
        "@types/pg": "^8.11.10",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "vitest": "^2.1.8"
    }

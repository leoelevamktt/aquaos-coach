DATABASE_URL=postgres://natacao:natacao@localhost:5432/natacao
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
SESSION_SECRET=change-me-in-development
# IA global da plataforma (AnyModel). Nunca versione a chave real.
LLM_API_KEY=sua-chave-anymodel-aqui
LLM_BASE_URL=https://anymodel.org/v1
LLM_MODEL=ag/gemini-3.7-flash-high
# Base privada de conhecimento RKF (DOCX/TXT/JSON). Mantenha o arquivo fora do Git.
RKF_KNOWLEDGE_PATH=./storage/knowledge/rkf-base.docx
# Se true, chamadas de IA falham quando a base não puder ser carregada.
RKF_KNOWLEDGE_REQUIRED=false
# Serviço de visão AquaVision (pose RTMO + tracking). Sem ele, a API usa o AquaMotion local.
VISION_URL=http://localhost:8800
VISION_TIMEOUT_MS=900000

# Caddy — HTTPS automático (Let's Encrypt) e proxy reverso.
# Defina APP_DOMAIN no .env do Docker Compose. O mesmo arquivo permanece
# válido entre ambientes e não precisa ser reescrito durante o deploy.
#
# NOTA: as rotas da API já incluem o prefixo /api/v1/... nativamente, então
# usamos `handle` (sem strip) em vez de `handle_path`.

{$APP_DOMAIN} {
	encode gzip

	# PDFs e relatórios podem ser grandes
	request_body {
		max_size 500MB
	}

	# API Fastify — prefixo preservado
	handle /api/* {
		reverse_proxy api:4000
	}

	# Arquivos enviados (streaming de vídeo suportado pelo Fastify static)
	handle /uploads/* {
		reverse_proxy api:4000
	}

	# Frontend Next.js (tudo o mais)
	reverse_proxy web:3000
}

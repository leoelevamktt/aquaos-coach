# Env de produção para o deploy AWS (docker-compose.aws.yml)
# Copie para .env na raiz do projeto na EC2 e preencha APENAS os segredos localmente.
# Nunca versione o .env real.

# Senha do Postgres — gere com: openssl rand -hex 16
POSTGRES_PASSWORD=

# Contas iniciais. Não deixe as senhas vazias: a API falha de forma segura
# quando precisa provisionar uma conta nova sem credencial configurada.
AUTH_COACH_EMAIL=treinador@elevamkt.digital
AUTH_COACH_PASSWORD=
AUTH_ATHLETE_EMAIL=atleta@elevamkt.digital
AUTH_ATHLETE_PASSWORD=

# Domínio público canônico do AquaOS Coach.
APP_DOMAIN=natacao.elevamkt.digital
CORS_ORIGINS=https://natacao.elevamkt.digital
APP_BASE_URL=https://natacao.elevamkt.digital
PUBLIC_API_URL=https://natacao.elevamkt.digital

# IA global da plataforma via AnyModel. A chave real fica apenas no servidor.
LLM_API_KEY=
LLM_BASE_URL=https://anymodel.org/v1
LLM_MODEL=ag/gemini-3.7-flash-high

# Base privada RKF em /data/storage/knowledge/rkf-base.docx.
# Em produção, mantenha true para impedir respostas sem a documentação metodológica.
RKF_KNOWLEDGE_REQUIRED=true

# Artefatos JSON de backup persistidos no volume da API.
BACKUP_PATH=/data/storage/backups

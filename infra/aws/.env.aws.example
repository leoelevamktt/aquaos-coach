# Env de produção para o deploy AWS (docker-compose.aws.yml)
# Copie para .env na raiz do projeto na EC2 e preencha os valores.

# Senha do Postgres — gere com: openssl rand -hex 16
POSTGRES_PASSWORD=

# Origens permitidas no CORS da API (frontend público, separadas por vírgula).
# Cookie de sessão exige mesma origem/HTTPS.
CORS_ORIGINS=https://app.exemplo.com

# URL pública da API — é injetada NO BUILD do Next.js (NEXT_PUBLIC_*).
# Se mudar o domínio depois, precisa rebuildar o container web.
PUBLIC_API_URL=https://app.exemplo.com
